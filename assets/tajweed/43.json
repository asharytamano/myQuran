    {
      "ayah_number": 4,
      "text_tajweed_html": "وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed> ف<tajweed class=madda_obligatory>ِىٓ</tajweed> أُ<tajweed class=ghunnah>مّ</tajweed>ِ <tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بِ لَدَيْنَا لَعَلِىٌّ حَك<tajweed class=madda_permissible>ِي</tajweed>مٌ <span class=end>٤</span>"
    },
    {
      "ayah_number": 5,
      "text_tajweed_html": "أَفَنَضْرِبُ عَ<tajweed class=ikhafa>نك</tajweed>ُمُ <tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ذِّكْرَ صَفْحًا أَ<tajweed class=ikhafa>ن ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ قَوْ<tajweed class=idgham_ghunnah>مًا م</tajweed>ُّسْرِف<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٥</span>"
    },
    {
      "ayah_number": 6,
      "text_tajweed_html": "وَكَمْ أَرْسَلْنَا م<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِ<tajweed class=ikhafa>ىٍّ ف</tajweed>ِى <tajweed class=ham_wasl>ٱ</tajweed>لْأَوَّل<tajweed class=madda_permissible>ِي</tajweed>نَ <span class=end>٦</span>"
    },
    {
      "ayah_number": 7,
      "text_tajweed_html": "وَمَا يَأْتِيه<tajweed class=idgham_shafawi>ِم م</tajweed>ّ<tajweed class=idgham_ghunnah>ِن ن</tajweed>َّبِىٍّ إِلَّا كَانُو<tajweed class=slnt>اْ</tajweed> بِه<tajweed class=madda_normal>ِۦ</tajweed> يَسْتَهْزِء<tajweed class=madda_permissible>ُو</tajweed>نَ <span class=end>٧</span>"
    },
    {
