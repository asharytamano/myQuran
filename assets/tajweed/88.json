{
  "surah": 88,
  "ayahs": [
    {
      "ayah_number": 1,
      "text_tajweed_html": "هَلْ أَتَ<tajweed class=madda_normal>ـٰ</tajweed>كَ حَدِيثُ <tajweed class=ham_wasl>ٱ</tajweed>لْغَ<tajweed class=madda_normal>ـٰ</tajweed>شِيَةِ <span class=end>١</span>"
    },
    {
      "ayah_number": 2,
      "text_tajweed_html": "وُجُو<tajweed class=idgham_ghunnah>هٌ ي</tajweed>َوْمَئِذٍ خَ<tajweed class=madda_normal>ـٰ</tajweed>شِعَةٌ <span class=end>٢</span>"
    },
    {
      "ayah_number": 3,
      "text_tajweed_html": "عَامِلَ<tajweed class=idgham_ghunnah>ةٌ ن</tajweed>َّاصِبَةٌ <span class=end>٣</span>"
    },
    {
      "ayah_number": 4,
      "text_tajweed_html": "تَصْلَىٰ نَارًا حَامِيَةً <span class=end>٤</span>"
    },
    {
      "ayah_number": 5,
      "text_tajweed_html": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ <span class=end>٥</span>"
    },
    {
      "ayah_number": 6,
      "text_tajweed_html": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ<tajweed class=ikhafa>ن ض</tajweed>َر<tajweed class=madda_permissible>ِي</tajweed>عٍ <span class=end>٦</span>"
    },
    {
      "ayah_number": 7,
      "text_tajweed_html": "لَّا يُسْمِنُ وَلَا يُغْنِى مِ<tajweed class=ikhafa>ن ج</tajweed><tajweed class=madda_permissible>ُو</tajweed>عٍ <span class=end>٧</span>"
    },
    {
      "ayah_number": 8,
      "text_tajweed_html": "وُجُو<tajweed class=idgham_ghunnah>هٌ ي</tajweed>َوْمَئِ<tajweed class=idgham_ghunnah>ذٍ ن</tajweed>َّاعِمَةٌ <span class=end>٨</span>"
    },
    {
      "ayah_number": 9,
      "text_tajweed_html": "لِّسَعْيِهَا رَاضِيَةٌ <span class=end>٩</span>"
    },
    {
      "ayah_number": 10,
      "text_tajweed_html": "فِى جَ<tajweed class=ghunnah>نّ</tajweed>َةٍ عَالِيَةٍ <span class=end>١٠</span>"
    }
  ]
}